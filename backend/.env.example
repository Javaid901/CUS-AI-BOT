# ============================================================================
# CUS AI Assistant — backend environment configuration
# Copy to `.env` and adjust as needed. All values have sensible defaults.
# ============================================================================

# ----- Service -----
APP_NAME=CUS AI Assistant
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ----- Database -----
# SQLite by default (zero setup). For PostgreSQL (recommended in production):
# DATABASE_URL=postgresql+psycopg://cus:cus@localhost:5432/cus_ai
DATABASE_URL=sqlite:///./cus_ai.db
DB_ECHO=false

# ----- Security / JWT -----
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ----- CORS -----
# Comma-separated origins. In production, list the exact frontend URL(s).
# For local dev with python -m http.server on port 8200:
CORS_ORIGINS=http://localhost:8200,http://127.0.0.1:8200

# ----- Ollama / LLM -----
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024

# ----- Vector store (ChromaDB) -----
CHROMA_PERSIST_DIR=./chroma_store

# ----- Retrieval -----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
SCORE_THRESHOLD=0.0

# ----- File upload -----
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# ----- Rate limiting (chat) -----
RATE_LIMIT_PER_MINUTE=20

# ----- Seeded admin -----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@cus.ac.in
